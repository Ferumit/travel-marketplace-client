rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uidField) {
      return isAuthenticated() && request.auth.uid == uidField;
    }
    
    // 1. ПОЛЬЗОВАТЕЛИ
    match /users/{userId} {
      // Чтение доступно любому авторизованному — необходимо для поиска компаньонов
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
      // Любой авторизованный может обновить rating/reviewCount
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'reviewCount']);
    }
    
    // 2. ПАРТНЕРЫ
    match /partners/{partnerId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(partnerId);
    }
    
    // 3. ТУРЫ
    match /tours/{tourId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.guideId) || isOwner(resource.data.driverId);
    }

    // 4. МАРШРУТЫ
    match /routes/{routeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 5. БРОНИРОВАНИЯ
    match /bookings/{bookingId} {
      allow read, update: if isAuthenticated() && (
        resource == null ||
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.partnerId ||
        request.auth.uid == resource.data.driverId ||
        request.auth.uid == resource.data.guideId
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if false; 
    }

    // 5.1 ОПЛАТЫ
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource == null || request.auth.uid == resource.data.userId
      );
      // Документы платежей создаёт и меняет только Cloud Function (Admin SDK): клиент не должен
      // иметь возможности «оплатить» заказ записью в Firestore.
      allow create, update: if false;
      allow delete: if false;
    }

    // 6. АКТИВНЫЕ МАРШРУТЫ
    match /active_trips/{tripId} {
      // list (query) — arrayContains фильтр не может обращаться к resource.data,
      // поэтому разрешаем запросы любому авторизованному.
      // Клиентский запрос уже фильтрует по participantIds/userId.
      allow list: if isAuthenticated();
      // get (точечное чтение) — строгая проверка участника
      allow get: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        (resource.data.participantIds is list &&
         request.auth.uid in resource.data.participantIds) ||
        request.auth.uid == resource.data.partnerId ||
        request.auth.uid == resource.data.driverId ||
        request.auth.uid == resource.data.guideId
      );
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        (resource.data.participantIds is list &&
         request.auth.uid in resource.data.participantIds) ||
        request.auth.uid == resource.data.partnerId ||
        request.auth.uid == resource.data.driverId ||
        request.auth.uid == resource.data.guideId
      );
      allow create: if isAuthenticated();
      allow delete: if false;
    }

    // 7. ОТЗЫВЫ
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.authorId);
    }

    // 8. WAVE - групповой чат (Firebase-backed mesh)
    match /wave_rooms/{roomId} {
      allow read, write: if isAuthenticated();
      match /messages/{msgId} {
        allow read, write: if isAuthenticated();
      }
      match /members/{memberId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 9. СООБЩЕНИЯ АКТИВНЫХ ПОЕЗДОК (ЧАТ)
    match /active_trips_chats/{tripId} {
      allow read, write: if isAuthenticated();
      match /messages/{msgId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 10. ТЕХОСМОТРЫ И ДОКУМЕНТЫ АВТОМОБИЛЕЙ (Партнёры)
    match /vehicle_inspections/{inspectionId} {
      allow create: if isAuthenticated();
      // Только владелец (водитель) может читать свои осмотры.
      // Обновление нужно для изменения статуса (approve/reject) — 
      // полноценная проверка admin-роли добавляется при создании ролей.
      allow read: if isAuthenticated() && request.auth.uid == resource.data.driverId;
      allow update: if isAuthenticated();
    }

    // 11. SOS-СИГНАЛЫ (иммутабельные)
    match /sos_signals/{signalId} {
      // Любой авторизованный пользователь может создать или обновить запись.
      // update нужен т.к. несколько relay-участников пишут один signalId:
      // первый — create, остальные — update (Firestore .set() на существующем doc).
      allow create, update: if isAuthenticated();
      // Чтение для всех авторизованных (мониторинг в обоих приложениях)
      allow read: if isAuthenticated();
      // Удаление запрещено — записи иммутабельны
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
